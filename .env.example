# =============================================================================
# Evoly — Environment Variables
# =============================================================================
# Copy this file to .env (repo root) and fill in your values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# Never commit .env or any file with real secrets.
# =============================================================================

# =============================================================================
# Database
# =============================================================================

# PostgreSQL connection string (used by Prisma across all apps)
DATABASE_URL="postgresql://user:password@localhost:5432/evoly"

# =============================================================================
# Authentication (NextAuth v5)
# =============================================================================

# Random secret — generate with: openssl rand -base64 32
# Used to sign JWTs and session cookies
AUTH_SECRET="replace-with-random-secret"

# Full URL of the app (used in email verification and password reset links)
NEXTAUTH_URL="http://localhost:3001"

# Google OAuth — create credentials at https://console.developers.google.com
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# =============================================================================
# Stripe
# =============================================================================

# Stripe secret key (server-side only) — from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."

# Stripe publishable key (client-side safe) — from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe webhook signing secret — from https://dashboard.stripe.com/webhooks
# Used to validate incoming webhook events (payment_intent.succeeded, etc.)
STRIPE_WEBHOOK_SECRET="whsec_..."

# =============================================================================
# Email (Resend)
# =============================================================================

# Resend API key — from https://resend.com/api-keys
RESEND_API_KEY="re_..."

# Default sender address for transactional emails
# Must be a verified domain in your Resend account
FROM_EMAIL="Evoly <noreply@evoly.me>"

# =============================================================================
# Application URLs
# =============================================================================

# Public URL of the dashboard app (apps/app)
# Used in email links, Stripe return URLs, and internal redirects
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Hostname of the dashboard app (without protocol)
# Used for subdomain and custom domain routing in middleware
NEXT_PUBLIC_APP_HOST="localhost:3001"

# Base domain for subdomain routing (e.g. org.evoly.me)
NEXT_PUBLIC_BASE_DOMAIN="localhost:3001"

# Public URL of the marketing website (apps/web)
# Used for sitemap and robots.txt generation
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Public URL of the scanner PWA (apps/scanner)
# Used to generate QR codes and check-in links
NEXT_PUBLIC_SCANNER_URL="http://localhost:3002"

# =============================================================================
# Custom Domains
# =============================================================================

# CNAME target shown to users when configuring custom domains
# (e.g. "Point your CNAME to app.evoly.me")
CNAME_TARGET="app.evoly.me"
NEXT_PUBLIC_CNAME_TARGET="app.evoly.me"

# URL of the domain provisioner service (internal infra)
# Handles TLS certificate issuance and reverse-proxy routing
PROVISIONER_URL="https://provisioner.example.com"

# Shared secret for authenticating requests to the provisioner service
PROVISIONER_SECRET="replace-with-provisioner-secret"

# =============================================================================
# Cron Jobs
# =============================================================================

# Secret token sent in Authorization header by the cron scheduler
# Used by all /api/cron/* routes to reject unauthorized calls
# Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-cron-secret"

# =============================================================================
# Sentry (optional — error monitoring)
# =============================================================================

# Sentry DSN — from https://sentry.io (project → Settings → Client Keys)
# Leave empty to disable Sentry in development
# SENTRY_DSN=""

# Sentry auth token — used for source-map uploads during build
# SENTRY_AUTH_TOKEN=""

# Sentry organization and project slugs (for sentry.properties)
# SENTRY_ORG=""
# SENTRY_PROJECT=""
