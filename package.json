{
  "name": "evoly",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "db:generate": "pnpm --filter @evoly/db generate",
    "db:migrate": "pnpm --filter @evoly/db migrate:dev",
    "db:push": "pnpm --filter @evoly/db db:push",
    "db:studio": "pnpm --filter @evoly/db studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "workspaces": ["apps/*", "packages/*"]
}
